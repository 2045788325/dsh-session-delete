{
  "name": "@local/dsh-session-delete",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "真正删除 DeepSeek Assistant 会话：从侧边栏「...」菜单删除会话及其持久化数据，并把它从运行中的会话列表里移除（不是归档）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-assistant",
    "cordis-plugin",
    "session",
    "delete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2045788325/dsh-session-delete.git"
  },
  "author": "2045788325"
}
